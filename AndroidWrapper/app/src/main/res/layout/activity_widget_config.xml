<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9ff"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚆 LRT Jabodebek Widget"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#00288e"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfigurasi tampilan widget beranda Anda"
            android:textSize="14sp"
            android:textColor="#757684"
            android:layout_marginBottom="24dp" />

        <!-- Station Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PILIH STASIUN ANDA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#444653"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_station"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/spinner_bg"
            android:layout_marginBottom="24dp" />

        <!-- Direction Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PILIH ARAH KERETA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#444653"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radio_direction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/radio_inbound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⬆️  Ke Dukuh Atas BSI"
                android:textSize="16sp"
                android:checked="true"
                android:padding="12dp" />

            <RadioButton
                android:id="@+id/radio_outbound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⬇️  Dari Dukuh Atas BSI"
                android:textSize="16sp"
                android:padding="12dp" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_confirm_config"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Pasang Widget"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#00288e"
            android:textColor="@android:color/white"
            android:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>
